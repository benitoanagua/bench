{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": { "entry": ["tooling/**/*.mjs", "scripts/storybook-pages-smoke.mjs"] },
    "apps/storybook": {
      "entry": ["src/**/*.stories.ts", "src/story-helpers.ts", ".storybook/*.ts"]
    },
    "packages/components": {
      "entry": ["src/index.ts", "stencil.config.ts", "stencil.typecheck.config.ts"],
      "ignoreDependencies": ["jest", "jest-cli"]
    },
    "packages/fonts": { "ignoreDependencies": ["@ibm/plex-mono", "@ibm/plex-sans"] },
    "packages/icons": { "ignoreDependencies": ["@carbon/icons"] }
  },
  "ignoreExportsUsedInFile": true
}
