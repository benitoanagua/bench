{
  "name": "@bench/icons",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "lint": "node ../../tooling/lint/package-rules.mjs icons"
  },
  "dependencies": {},
  "devDependencies": {
    "@carbon/icons": "^11.55.0",
    "typescript": "^5.7.0"
  },
  "repository": "github:benitoanagua/bench",
  "license": "MIT",
  "bugs": "https://github.com/benitoanagua/bench/issues",
  "homepage": "https://github.com/benitoanagua/bench#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
