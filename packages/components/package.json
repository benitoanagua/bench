{
  "name": "@bench/components",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "import": "./dist/loader/index.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "build": "stencil build --docs-readme false",
    "typecheck": "stencil build --dev --docs-readme false --config stencil.typecheck.config.ts",
    "test": "stencil test --spec",
    "lint": "node ../../tooling/lint/package-rules.mjs components"
  },
  "dependencies": {
    "@bench/icons": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.38.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0"
  },
  "repository": "github:benitoanagua/bench",
  "license": "MIT",
  "bugs": "https://github.com/benitoanagua/bench/issues",
  "homepage": "https://github.com/benitoanagua/bench#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
