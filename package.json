{
  "name": "bench-design-system",
  "description": "Bench — a design system for power users who have this software open 8 hours a day. Stencil + Web Components.",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=!@bench/showcase",
    "lint": "node tooling/lint/design-rules.mjs && turbo lint",
    "story:dev": "pnpm --filter @bench/histoire story:dev",
    "showcase": "pnpm --filter @bench/showcase dev",
    "build:showcase": "pnpm --filter @bench/showcase build",
    "test:showcase": "pnpm --filter @bench/showcase test",
    "check": "pnpm check:icons-consistency && pnpm check:framework && pnpm check:api && pnpm check:adapters && pnpm check:dependencies && pnpm check:tokens && pnpm check:dead-code && pnpm check:matrix && pnpm check:functions && pnpm check:links && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release": "changeset publish",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:contracts": "pnpm --filter @bench/histoire test:e2e --spec='contracts.spec.ts'",
    "test:a11y": "pnpm --filter @bench/histoire test:e2e --spec='a11y.spec.ts'",
    "check:framework": "node tooling/validation/no-lit.mjs",
    "check:dependencies": "node tooling/validation/dependency-consistency.mjs",
    "check:tokens": "node tooling/validation/token-references.mjs",
    "check:dead-code": "knip",
    "check:matrix": "node tooling/validation/component-matrix.mjs",
    "check:functions": "node tooling/validation/validate-functions-manifest.mjs apps/showcase/bench.functions.json",
    "check:links": "node tooling/validation/links.mjs",
    "check:api": "node tooling/validation/public-api.mjs",
    "check:adapters": "node tooling/validation/adapter-parity.mjs",
    "fonts:build": "pnpm --filter @bench/fonts build",
    "icons:generate": "node tooling/icons/generate.mjs",
    "check:icons-consistency": "node tooling/validation/icon-consistency.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "knip": "^5.88.1",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
